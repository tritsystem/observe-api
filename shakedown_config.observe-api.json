{
  "repo": {
    "path": ".",
    "extra_skip_dirs": ["repos", "data", "models", "checkpoints", "private", ".pytest_cache"],
    "extensions": [".py", ".md"]
  },
  "index_out_dir": "data/self-index-v2",
  "concepts": [
    {"type": "endpoint", "pattern": "@app\\.(get|post)\\(\"([^\"]+)\"", "name_group": 2},
    {"type": "env_var", "pattern": "os\\.environ\\.get\\([\"']([A-Z_][A-Z0-9_]*)[\"']", "name_group": 1}
  ],
  "evidence": {
    "rules": {
      "endpoint": [
        {"kind": "test_grep", "glob": "tests/*.py"},
        {"kind": "disk_glob", "pattern": "private/*/repo"},
        {"kind": "sqlite", "db": "observe_api.db", "table": "usage_log", "match_mode": "any_rows"}
      ],
      "env_var": [
        {"kind": "test_grep", "glob": "tests/*.py"}
      ]
    }
  }
}
