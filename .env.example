# Copy to .env (or set these as real environment variables) -- never commit
# a filled-in .env to git.

# Stripe (from https://dashboard.stripe.com/apikeys and
# https://dashboard.stripe.com/webhooks after creating an endpoint pointing
# at https://YOUR_DOMAIN/v1/webhook/stripe)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Pricing: $5 -> 50,000 credits by default (0.01 cent/search) -- priced to
# clearly undercut the token cost a search saves, not around infra cost.
# See billing.py's own comment for the reasoning.
OBSERVE_PACKAGE_PRICE_CENTS=500
OBSERVE_PACKAGE_CREDITS=50000
OBSERVE_CREDITS_PER_SEARCH=1

# Where Checkout sends the buyer after payment -- doesn't need to be a real
# product page for v1, just something that confirms success/cancellation.
OBSERVE_CHECKOUT_SUCCESS_URL=https://YOUR_DOMAIN/success
OBSERVE_CHECKOUT_CANCEL_URL=https://YOUR_DOMAIN/cancel

# Index/model paths (defaults match the Dockerfile's /data volume)
OBSERVE_INDEX_DIR=/data/observe-index
OBSERVE_MODEL_PATH=sentence-transformers/all-MiniLM-L6-v2
