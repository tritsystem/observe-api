{
  "repo": {
    "path": "G:/dev/observe-api/repos/react",
    "extra_skip_dirs": [],
    "extensions": [".js"]
  },
  "concepts": [
    {"type": "feature_flag", "pattern": "export const (\\w+): boolean", "name_group": 1},
    {"type": "env_var", "pattern": "process\\.env\\.([A-Z_][A-Z0-9_]*)", "name_group": 1}
  ],
  "evidence": {
    "rules": {
      "feature_flag": [
        {"kind": "file_grep", "glob": "packages/**/__tests__/**/*.js"}
      ],
      "env_var": [
        {"kind": "file_grep", "glob": "packages/**/__tests__/**/*.js"},
        {"kind": "file_grep", "glob": "scripts/**/*.js"},
        {"kind": "file_grep", "glob": "fixtures/**/*.js"},
        {"kind": "file_grep", "glob": "packages/**/e2e/**/*.js"}
      ]
    }
  }
}
